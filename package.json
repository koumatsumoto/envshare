{
  "name": "envshare",
  "version": "0.1.0",
  "description": "Share encrypted dotenv settings in Git and sync changes into a local .env.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koumatsumoto/envshare.git"
  },
  "type": "module",
  "files": [
    "dist/cli.js",
    "dist/dotenv.js",
    "dist/envelope.js",
    "dist/error.js",
    "dist/files.js",
    "dist/git.js"
  ],
  "bin": {
    "envshare": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test",
    "test:package": "node scripts/check-package.mjs"
  },
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "typescript": "7.0.2"
  }
}
